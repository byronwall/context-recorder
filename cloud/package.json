{
  "name": "context-recorder-cloud",
  "private": true,
  "type": "module",
  "scripts": {
    "copy-viewer": "node scripts/copy-viewer.mjs",
    "predev": "pnpm run copy-viewer",
    "dev": "wrangler dev",
    "prebuild": "pnpm run copy-viewer",
    "build": "wrangler deploy --dry-run --outdir dist",
    "pretest": "pnpm run copy-viewer",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types --include-runtime false",
    "db:migrate:local": "wrangler d1 migrations apply DB --local"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@modelcontextprotocol/server": "2.3.1",
    "agents": "0.29.0",
    "jose": "6.2.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.6",
    "@cloudflare/workers-types": "5.20261019.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.151.3"
  }
}
