{
  "manifest_version": 3,
  "name": "Context Recorder Bridge",
  "version": "0.2.3",
  "description": "Sends page context (clicked elements, console errors, failed requests) to the Context Recorder macOS app on localhost.",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "alarms",
    "scripting",
    "pageCapture"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "page.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "relay.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Context Recorder Bridge",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "host_permissions": [
    "<all_urls>"
  ]
}
